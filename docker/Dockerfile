# check=skip=InvalidDefaultArgInFrom
ARG BASE_IMAGE=amazonlinux:2023
FROM ${BASE_IMAGE} AS build

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /workspace

ARG PRODUCT
ARG BUILD_VERSION
ARG BUILD_REVISION=1
ARG TARGET_ARCH

ARG PODMAN_TAG
ARG UPSTREAM_SHA256

ARG NETAVARK_TAG
ARG NETAVARK_UPSTREAM_SHA256
ARG NETAVARK_VENDOR_SHA256

ARG AARDVARK_TAG
ARG AARDVARK_UPSTREAM_SHA256
ARG AARDVARK_VENDOR_SHA256

ARG RUST_MIN_VERSION

ARG CRUN_TAG
ARG CRUN_VERSION
ARG CRUN_ARCHIVE_SHA256

ARG CONMON_TAG
ARG CONMON_VERSION
ARG CONMON_ARCHIVE_SHA256

ARG CONTAINERS_COMMON_TAG
ARG CONTAINERS_COMMON_VERSION
ARG CONTAINERS_COMMON_ARCHIVE_SHA256
ARG SHORTNAMES_COMMIT
ARG SHORTNAMES_SHA256
ARG REDHAT_RELEASE_KEY_SHA256

ARG PASST_TAG
ARG PASST_ARCHIVE_SHA256

ARG CATATONIT_TAG
ARG CATATONIT_VERSION
ARG CATATONIT_ARCHIVE_SHA256

COPY scripts /workspace/scripts
COPY packaging /workspace/packaging

RUN chmod +x /workspace/scripts/container/build.sh && \
    PRODUCT="${PRODUCT}" \
    BUILD_VERSION="${BUILD_VERSION}" \
    BUILD_REVISION="${BUILD_REVISION}" \
    TARGET_ARCH="${TARGET_ARCH}" \
    PODMAN_TAG="${PODMAN_TAG}" \
    UPSTREAM_SHA256="${UPSTREAM_SHA256}" \
    NETAVARK_TAG="${NETAVARK_TAG}" \
    NETAVARK_UPSTREAM_SHA256="${NETAVARK_UPSTREAM_SHA256}" \
    NETAVARK_VENDOR_SHA256="${NETAVARK_VENDOR_SHA256}" \
    AARDVARK_TAG="${AARDVARK_TAG}" \
    AARDVARK_UPSTREAM_SHA256="${AARDVARK_UPSTREAM_SHA256}" \
    AARDVARK_VENDOR_SHA256="${AARDVARK_VENDOR_SHA256}" \
    RUST_MIN_VERSION="${RUST_MIN_VERSION}" \
    CRUN_TAG="${CRUN_TAG}" \
    CRUN_VERSION="${CRUN_VERSION}" \
    CRUN_ARCHIVE_SHA256="${CRUN_ARCHIVE_SHA256}" \
    CONMON_TAG="${CONMON_TAG}" \
    CONMON_VERSION="${CONMON_VERSION}" \
    CONMON_ARCHIVE_SHA256="${CONMON_ARCHIVE_SHA256}" \
    CONTAINERS_COMMON_TAG="${CONTAINERS_COMMON_TAG}" \
    CONTAINERS_COMMON_VERSION="${CONTAINERS_COMMON_VERSION}" \
    CONTAINERS_COMMON_ARCHIVE_SHA256="${CONTAINERS_COMMON_ARCHIVE_SHA256}" \
    SHORTNAMES_COMMIT="${SHORTNAMES_COMMIT}" \
    SHORTNAMES_SHA256="${SHORTNAMES_SHA256}" \
    REDHAT_RELEASE_KEY_SHA256="${REDHAT_RELEASE_KEY_SHA256}" \
    PASST_TAG="${PASST_TAG}" \
    PASST_ARCHIVE_SHA256="${PASST_ARCHIVE_SHA256}" \
    CATATONIT_TAG="${CATATONIT_TAG}" \
    CATATONIT_VERSION="${CATATONIT_VERSION}" \
    CATATONIT_ARCHIVE_SHA256="${CATATONIT_ARCHIVE_SHA256}" \
    /workspace/scripts/container/build.sh

FROM scratch AS artifact-export

COPY --from=build /out/ /
