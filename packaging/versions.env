# Pinned versions for upstream inputs.
# The shared build scripts source this file directly.
#
# Target: Amazon Linux 2023 (amazonlinux:2023), x86_64 and aarch64. Every
# product is compiled inside that image with the distro's own toolchains
# (golang, rust/cargo, gcc); the in-container scripts assert the toolchain
# satisfies the pinned upstream's minimum (go.mod / RUST_MIN_VERSION).

# Podman (Go)
# UPSTREAM_SHA256: sha256 of the GitHub tag archive for PODMAN_TAG.
PODMAN_TAG=v6.1.0
UPSTREAM_SHA256=e086183db2f852476a7fa2580d0276cef32086b4cf17ae7020948f06eb613e0d

# netavark (Rust) — network stack required by the Podman package built here.
# NETAVARK_UPSTREAM_SHA256: sha256 of the GitHub source archive tarball.
# NETAVARK_VENDOR_SHA256:   sha256 of the release vendored-deps tarball.
# RUST_MIN_VERSION:         minimum rustc the distro toolchain must provide (>= netavark MSRV).
NETAVARK_TAG=v2.0.0
NETAVARK_UPSTREAM_SHA256=031aeeacc930382e8635d40a885798eff1da164dfcf9024b698f822e5995d9c8
NETAVARK_VENDOR_SHA256=86de7eb3a4e9ecc4acd5addc462879e8f2bac3562a4b99f12a4be67e5218c2cb
RUST_MIN_VERSION=1.88.0

# aardvark-dns (Rust) — DNS server required by the Podman package / netavark.
# Reuses the shared RUST_MIN_VERSION above.
AARDVARK_TAG=v2.0.0
AARDVARK_UPSTREAM_SHA256=d3f5d6b3be3c2d80e8257fb9467e34ff104f299474427979454034dca6dc88cc
AARDVARK_VENDOR_SHA256=c5ca49d98c535fa3c8d0d195512faf1f8610ad9ca4f62bec73c7bbfc4ddcc0b6

# crun (C) — fast OCI runtime and Podman's default runtime.
# Built from the upstream release dist tarball (self-contained autotools tree with
# bundled libocispec + blake3); the tag is the bare version with no leading "v".
# CRUN_ARCHIVE_SHA256: sha256 of the GitHub release dist tarball crun-<VERSION>.tar.gz.
CRUN_TAG=1.28
CRUN_VERSION=1.28
CRUN_ARCHIVE_SHA256=eb8fe73ffe44d868b14bb94fa6c295bd57e8bf023de43b61579da826c07cc406

# conmon (C) — container monitor used by Podman and CRI-O.
# CONMON_ARCHIVE_SHA256: sha256 of the GitHub tag archive for CONMON_TAG.
CONMON_TAG=v2.2.1
CONMON_VERSION=2.2.1
CONMON_ARCHIVE_SHA256=814fb5979a3a4b8576b1f901e606b482bebb41cb7e57926e6d5765ee786b96d3

# containers-common (config files + man pages; noarch)
# Source lives in the containers/container-libs monorepo; the tag is
# "common/v<VERSION>". The same checkout supplies storage.conf and the
# registries/policy defaults (its storage/ tree is v1.63.0, whose storage.conf
# leaves graphroot/runroot unset so rootless Podman 6.1 keeps its per-user
# default). The spec also installs the containers/shortnames alias table,
# pinned to an exact commit.
# CONTAINERS_COMMON_ARCHIVE_SHA256: sha256 of the GitHub container-libs tag archive.
# SHORTNAMES_SHA256: sha256 of shortnames.conf at SHORTNAMES_COMMIT.
# REDHAT_RELEASE_KEY_SHA256: sha256 of https://access.redhat.com/security/data/fd431d51.txt
#   (the spec's Source2; installed as RPM-GPG-KEY-redhat-release because AL2023
#   defines %fedora — Amazon's own containers-common ships it too).
CONTAINERS_COMMON_TAG=common/v0.68.0
CONTAINERS_COMMON_VERSION=0.68.0
CONTAINERS_COMMON_ARCHIVE_SHA256=61391b67e58ecffe4aae8ed620f35c57098b612d0b602d640ad541fb24b06908
SHORTNAMES_COMMIT=2694878802be99221dc90485af78d1ea221249d9
SHORTNAMES_SHA256=c19bf37a7366d64b9605dfee0b5dd0fce5c1ec1edbb34b53d4c87a9e536525a8
REDHAT_RELEASE_KEY_SHA256=d4b2543626bee31d9438d4a31731aae712c072893c7aed8854f16c42fafc742b

# passt (C) — user-mode networking (pasta/pesto) for Podman.
# Amazon Linux ships no passt, so it is built from the upstream tag snapshot on
# passt.top (cgit snapshot tarballs are deterministic). The tag is
# <YYYY_MM_DD>.<short-hash>; the RPM Version is derived from it in Fedora's
# snapshot form 0^<YYYYMMDD>.g<short-hash>.
# PASST_ARCHIVE_SHA256: sha256 of https://passt.top/passt/snapshot/passt-<TAG>.tar.xz
PASST_TAG=2026_07_28.f8df3f1
PASST_ARCHIVE_SHA256=fcfeb5fbdf775bcc48edc1d5eac8a6d57bc333f8e67b714149376d36061416f0

# catatonit (C) — minimal init that podman requires (pods, --init).
# Amazon Linux ships no catatonit; the spec comes from the SPAL source RPM.
# CATATONIT_ARCHIVE_SHA256: sha256 of the GitHub tag archive for CATATONIT_TAG.
CATATONIT_TAG=v0.2.1
CATATONIT_VERSION=0.2.1
CATATONIT_ARCHIVE_SHA256=771385049516fdd561fbb9164eddf376075c4c7de3900a8b18654660172748f1
